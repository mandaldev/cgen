{
  name "cgen dep demo"
  author "Mandal Dev"
  license "GPL-3.0"

  target [
    {
      name "dep_demo"
      language "c++"
      std "c++17"
      type "exe"

      src [
        "src/main.cpp"
      ]

      dep [
        "G"
      ]
    }

    {
      name "A"
      language "c++"
      std "c++17"
      type "lib"

      src [
        "src/A.cpp"
      ]

      dep [
        { name "B" private "true" }
        { name "C" private "false" }
      ]
    }

    {
      name "B"
      language "c++"
      std "c++17"
      type "lib"

      src [
        "src/B.cpp"
      ]
      dep [
      ]
    }

    {
      name "C"
      language "c++"
      std "c++17"
      type "lib"

      src [
        "src/C.cpp"
      ]
      dep [
      ]
    }

    {
      name "D"
      language "c++"
      std "c++17"
      type "lib"

      src [
        "src/D.cpp"
      ]

      dep [
        { name "E" private "true" }
        { name "F" }
      ]
    }

    {
      name "E"
      language "c++"
      std "c++17"
      type "lib"

      src [
        "src/E.cpp"
      ]

      dep [
      ]
    }

    {
      name "F"
      language "c++"
      std "c++17"
      type "lib"

      src [
        "src/F.cpp"
      ]

      dep [
      ]
    }

    {
      name "G"
      language "c++"
      std "c++17"
      type "lib"

      src [
        "src/G.cpp"
      ]

      dep [
        { name "A" private "true" }
        "D"
      ]
    }
  ]
}
