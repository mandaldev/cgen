{
  name "hw"
  author "Mandal Dev"
  license "GPL-3.0"

  target [
    {
      name "hw"
      language "c++"
      std "c++17"
      type "exe"

      desc "demo exe target with dep of a slib"

      src [
        "src/main.cpp"
      ]

      dep [
        "slib3"
      ]
    }

    {
      name "slib1"
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/slib1/lib.cpp"
      ]
    }

    {
      name "slib2"
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/slib2/lib.cpp"
      ]
      dep [
        "slib1"
      ]
    }

    {
      name "slib3"
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/slib3/lib.cpp"
      ]
      dep [
        "slib2"
      ]
    }

    {
      name "dlib1"
      language "c++"
      std "c++17"
      type "dlib"
      desc "demo dlib target with dep of a slib"

      src [
        "src/dlib1/lib.cpp"
      ]

      dep [
        "slib1"
      ]
    }

    {
      name "dlib2"
      language "c++"
      std "c++17"
      type "dlib"
      desc "demo dlib target with dep of a slib"

      src [
        "src/dlib2/lib.cpp"
      ]

      dep [
        "dlib1"
      ]
    }

    {
      name "dlib3"
      language "c++"
      std "c++17"
      type "dlib"
      desc "demo dlib target with dep of a slib"

      src [
        "src/dlib3/lib.cpp"
      ]

      dep [
        "dlib2"
      ]
    }
  ]
}
