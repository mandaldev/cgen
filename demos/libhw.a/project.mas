  target [
    {
      name "hw"

      language "c++"
      std "c++17"

      type "lib"
      src [
        "src/lib.cpp"
      ]

      install [
        {
          dir "hw"
          headers [
            "src/lib.hpp"
          ]
        }
      ]
    }
  ]
}
