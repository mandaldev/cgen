{
  name "hw"
  author "Mandal Dev"
  desc "cgen demo project: hello world"
  license "GPLv3"

  profile {
    debug_release {
      cflags "-Wall -g -O2 -DNDEBUG"
    }
  }

  target [
    {
      name "hw"

      language "c++"
      std "c++17"

      type "exe"
      src [
        "src/main.cpp"
      ]
    }
  ]
}
