{
  name "cgen"
  author "Mandal Dev"
  desc "A C and C++ stuff generator"
  license "GPLv3"

  target {
    cgen {
      language "c++"
      std "c++17"
      type "exe"

      src [
        "src/main.cpp"
        "src/Driver.cpp"
        "src/Project.cpp"
        "src/ProjectModel.cpp"
        "src/Target.cpp"
        "src/ninja.cpp"
        "src/pkgconf/pkgconf.cpp"
        "src/Cdb.cpp"
      ]

      pkgconf [
        "libpkgconf"
      ]
      extra_lflags "-lCom"

      install [
        {
          dir "share/cgen/licenses"
          files [
            "share/cgen/licenses/GPLv3"
            "share/cgen/licenses/GPLv3.header"
            "share/cgen/licenses/LGPLv3"
            "share/cgen/licenses/LGPLv3.header"
          ]
        }
      ]
    }
  }
}
