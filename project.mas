{
  name "cgen"
  author "Mandal Dev"
  license "GPL-3.0"

  target [
    {
      name "cgen"
      language "c++"
      std "c++17"
      type "exe"

      src [
        "src/main.cpp"
        "src/Driver.cpp"
        "src/Project.cpp"
        "src/Target.cpp"
        "src/ninja.cpp"
        "src/pkgconf/pkgconf.cpp"
        "src/Cdb.cpp"
      ]

      dep [
        "mas"
        "xo"
      ]
      pkgconf [
        "libpkgconf"
      ]
    }
    {
      name "mas"
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/mas/Value.cpp"
      ]

      install [
        {
          dir "include/mas"
          files [
            "src/mas/Value.hpp"
          ]
        }
      ]
    }
    {
      name "xo"
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/xo/CommandLine.cpp"
        "src/xo/exec.cpp"
      ]

      install [
        {
          dir "include/xo"
          files [
            "src/xo/CommandLine.hpp"
            "src/xo/exec.hpp"
          ]
        }
      ]
    }
  ]
}
