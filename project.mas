{
  name "cgen"
  author "Mandal Dev"
  desc "A C and C++ stuff generator"
  license "GPLv3"

  target {
    cgen {
      language "c++"
      std "c++17"
      type "exe"

      src [
        "src/main.cpp"
        "src/Driver.cpp"
        "src/Project.cpp"
        "src/ProjectModel.cpp"
        "src/Target.cpp"
        "src/ninja.cpp"
        "src/pkgconf/pkgconf.cpp"
        "src/Cdb.cpp"
        "src/common.cpp"
      ]

      pkgconf [
        "libpkgconf"
      ]

      dep [
        { name "Com" static "true" }
      ]

      install [
        {
          dir "share"
          files [
            "assets/cgen"
          ]
        }
      ]
    }
  }
}
