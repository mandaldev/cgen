{
  name "cgen"
  author "Mandal Dev"
  desc "A C and C++ stuff generator"
  license "GPLv3"

  target {
    cgen {
      language "c++"
      std "c++17"
      type "exe"

      src [
        "src/main.cpp"
        "src/Driver.cpp"
        "src/Project.cpp"
        "src/Target.cpp"
        "src/ninja.cpp"
        "src/pkgconf/pkgconf.cpp"
        "src/Cdb.cpp"
      ]

      dep [
        "mas"
        "xo"
      ]
      pkgconf [
        "libpkgconf"
      ]

      install [
        {
          dir "share/cgen/licenses"
          files [
            "share/cgen/licenses/GPLv3"
            "share/cgen/licenses/GPLv3.header"
            "share/cgen/licenses/LGPLv3"
            "share/cgen/licenses/LGPLv3.header"
          ]
        }
      ]
    }

    mas {
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/mas/Value.cpp"
      ]

      install [
        {
          dir "include/mas"
          files [
            "src/mas/Value.hpp"
          ]
        }
      ]
    }

    xo {
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/xo/CommandLine.cpp"
        "src/xo/exec.cpp"
      ]

      install [
        {
          dir "include/xo"
          files [
            "src/xo/CommandLine.hpp"
            "src/xo/exec.hpp"
          ]
        }
      ]
    }
  }
}
